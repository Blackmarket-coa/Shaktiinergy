# ── Shakti Innergy site configuration ─────────────────────────────
# Copy to .env.local for development; set these in Vercel Project
# Settings → Environment Variables for production.

# FreeBlackMarket vendor handle whose catalog (events + offerings)
# renders on the site. https://api.freeblackmarket.com/store/vendors/{handle}
NEXT_PUBLIC_FBM_HANDLE=shaktiinnergy

# Blackout (Matrix) handle for the "Message on Blackout" connection.
# Becomes @{handle}:theblackout.app
NEXT_PUBLIC_BLACKOUT_HANDLE=malinda

# ── Supabase (scaffolded — not yet used by any feature) ───────────
# Project URL + anon key from Supabase Dashboard → Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
